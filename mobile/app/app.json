{
  "expo": {
    "name": "Dokulachtan",
    "slug": "dokulachtan-signer",
    "version": "1.3.8",
    "orientation": "portrait",
    "scheme": "dokulachtan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "cz.dokulachtan.signer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "minSdkVersion": 24,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dokulachtan.fly.dev",
              "pathPrefix": "/qes"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 10308,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "cz.dokulachtan.signer",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:dokulachtan.fly.dev"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Dokulachtan ověřuje Face ID, že podpis zadáváte vy."
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "disableAndroid": true
        }
      ],
      "./plugins/withSharePdfTarget.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "743b363a-4513-4346-9fbd-d8879dca3fb3"
      }
    },
    "owner": "slush0"
  }
}
