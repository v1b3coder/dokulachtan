# SMTP pro produkci (dokulachtan.fly.dev) — Brevo
#
# Zkopíruj na deploy/smtp.prod.env (gitignored), vyplň a nahraj:
#
#   make smtp-setup APP=dokulachtan FILE=deploy/smtp.prod.env
#   make smtp-check APP=dokulachtan
#   make smtp-test  APP=dokulachtan TO=nekdo@example.com
#
# Údaje jsou stejné jako u stagingu (jeden Brevo účet), liší se jen SMTP_FROM,
# aby pozvánky z produkce nechodily z „staging“ adresy.

SMTP_ADDRESS=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=priklad.cz
SMTP_FROM=app@priklad.cz
