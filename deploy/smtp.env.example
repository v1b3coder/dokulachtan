# SMTP pro staging (dokulachtan-staging.fly.dev) — Brevo
#
# Zkopíruj na deploy/smtp.env (gitignored), vyplň a nahraj:
#
#   make smtp-setup APP=dokulachtan-staging
#   make smtp-check APP=dokulachtan-staging
#   make smtp-test  APP=dokulachtan-staging TO=nekdo@example.com
#
# SMTP_FROM musí být platná e-mailová adresa: bez ní DocuSeal přepíše odesílatele
# prázdným řetězcem. Brevo navíc doménu odesílatele bez autentizace
# (Brevo code + DKIM v DNS) nahradí za @brevosend.com — výchozí hodnota níže
# je jen placeholder; vyplň schránku, kterou máš, a v Brevu ji ověř jako sendera.
#
# Login není e-mail účtu: Brevo u novějších účtů generuje [ID]@smtp-brevo.com.
# Free plán je 300 e-mailů/den.

SMTP_ADDRESS=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=priklad.cz
SMTP_FROM=app@priklad.cz
