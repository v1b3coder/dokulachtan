#!/usr/bin/env bash
# Základní testy před pushem: T0 (QES + JS) + app Jest + typecheck.
# Instalace: make hooks (dělá i fork-setup). Přeskočení: SKIP_QES_HOOK=1.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# Git nastavuje GIT_DIR pro hooky; bez tohoto by `git -C vendor/docuseal` viděl index
# parent repa (259 změn) a kontrola čistoty forku by vždy selhala.
unset GIT_DIR GIT_WORK_TREE

if [ "${SKIP_QES_HOOK:-0}" = 1 ]; then
  echo "pre-push: přeskočeno (SKIP_QES_HOOK=1)" >&2
  exit 0
fi

zero=0000000000000000000000000000000000000000
refs=$(mktemp)
qes_db=""
qes_schema=""
cleanup() {
  rm -f "$refs"
  if [ -n "$qes_db" ]; then
    rm -f "vendor/docuseal/db/$qes_db" "vendor/docuseal/tmp/$qes_schema"
  fi
}
trap cleanup EXIT
cat > "$refs"

need_qes=0
need_app=0
any=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # mazání větve
  any=1
  sha=$(git rev-parse --verify --quiet "${local_sha}^{commit}") || { need_qes=1; need_app=1; continue; }

  if [ "$remote_sha" = "$zero" ]; then             # nová větev → radši vše
    need_qes=1
    need_app=1
    continue
  fi

  files=$(git diff --name-only "$remote_sha..$sha" 2>/dev/null) || { need_qes=1; need_app=1; continue; }
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      mobile/*) need_app=1 ;;
      vendor/docuseal.rev|Makefile|test/*|scripts/*) need_qes=1 ;;
    esac
  done <<< "$files"
done < "$refs"

[ "$any" = 0 ] && { echo "pre-push: nic k pushi" >&2; exit 0; }

if [ "$need_qes" = 1 ]; then
  [ -d vendor/docuseal/.git ] || { echo "pre-push: chybí vendor/docuseal — make fork-setup" >&2; exit 1; }
  [ -z "$(git -C vendor/docuseal status --porcelain)" ] || {
    echo "pre-push: fork má necommitnuté změny — commitni je a bumpni pin" >&2; exit 1; }
  pin=$(cat vendor/docuseal.rev)
  [ "$(git -C vendor/docuseal rev-parse HEAD)" = "$(git -C vendor/docuseal rev-parse "$pin")" ] || {
    echo "pre-push: vendor/docuseal.rev ($pin) nesedí na HEAD forku" >&2
    echo "  → git -C vendor/docuseal rev-parse --short=8 HEAD > vendor/docuseal.rev" >&2
    exit 1; }
  qes_db="qes-hook-$$.sqlite3"
  qes_schema="qes-hook-$$.rb"
  echo "pre-push: F1 (T0 + app + typecheck, čerstvá DB)…" >&2
  QES_DB="$qes_db" QES_SCHEMA="$qes_schema" make test-t0
fi

if [ "$need_app" = 1 ]; then
  [ -d mobile/app/node_modules ] || { echo "pre-push: chybí mobile/app/node_modules — cd mobile/app && npm ci" >&2; exit 1; }
  echo "pre-push: F1 (app + typecheck)…" >&2
  make test-app
fi
